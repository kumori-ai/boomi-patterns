<?xml version="1.0" encoding="UTF-8"?>
<bns:Component xmlns:bns="http://api.platform.boomi.com/"
           type="connector-action"
           subType="wss"
           name="[WSS] BDI List Pipelines"
           folderId="{{FOLDER_ID}}" componentId="{{WSS_OPERATION_ID}}">
  <bns:encryptedValues/>
  <bns:description>Web Services Server GET /ws/simple/getListFlows (path kept for its callers): returns the BDI pipelines list as JSON. Basic auth is enforced by the runtime's shared web server. | built with boomi-companion v1.0.76</bns:description>
  <bns:object>
    <Operation>
      <Archiving directory="" enabled="false"/>
      <Configuration>
        <WebServicesServerListenAction inputType="none"
                                       objectName="ListFlows"
                                       operationType="GET"
                                       outputType="singlejson"
                                       responseProfile="{{PROFILE_ID}}"
                                       responseContentType="application/json"/>
      </Configuration>
      <Tracking>
        <TrackedFields/>
      </Tracking>
      <Caching/>
    </Operation>
  </bns:object>
</bns:Component>
